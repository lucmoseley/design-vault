#!/usr/bin/env sh
# workflow-core hook shim:

set -e # lucmoseley/workflow-core-tracker#745
WFC_PLUGIN_ROOT="$(node -e '
try {
  process.stdout.write(require("./scripts/lib/resolve-core.js").resolveCore());
} catch (err) {
  process.stderr.write(String(err instanceof Error ? err.message : err) + "\n");
  process.exit(1);
}' </dev/null)" || {
  echo 'post-commit: workflow-core'\''s post-commit checks did not run. Fix: open a Claude Code session in this repo so its project-scope workflow-core plugin installs, or set WORKFLOW_CORE_DIR to a workflow-core checkout.' >&2
  exit 0
}
export WFC_PLUGIN_ROOT
exec sh -e "$WFC_PLUGIN_ROOT/.husky/"post-commit "$@"
