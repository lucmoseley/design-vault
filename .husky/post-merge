#!/usr/bin/env sh
# workflow-core hook shim: core-owned; init and upgrade write it and a plugin
# bump leaves it unchanged. A gate of this repo's own goes in
# .husky/pre-commit.local or .husky/commit-msg.local.
#
# IMPLICIT:  on every post-merge, finds workflow-core through scripts/lib/resolve-core.js and runs that core's .husky/post-merge; where none resolves, says so and lets git go on.
# JUSTIFIED: fail-safe — a hook naming no plugin path cannot be left pointing at a pruned version or at another machine's install (workflow-core#1839).
# DEFEAT:    WORKFLOW_CORE_DIR or WORKFLOW_CORE_CHECKOUT chooses the core that runs; the core's .husky/post-merge names its own.

set -e # an adopter's git runs this file itself, outside husky's errexit wrapper (workflow-core#745)
WFC_PLUGIN_ROOT="$(node -e '
try {
  process.stdout.write(require("./scripts/lib/resolve-core.js").resolveCore());
} catch (err) {
  process.stderr.write(String(err instanceof Error ? err.message : err) + "\n");
  process.exit(1);
}' </dev/null)" || {
  echo 'post-merge: workflow-core'\''s post-merge checks did not run. Fix: open a Claude Code session in this repo so its project-scope workflow-core plugin installs, or set WORKFLOW_CORE_DIR to a workflow-core checkout.' >&2
  exit 0
}
export WFC_PLUGIN_ROOT
exec sh -e "$WFC_PLUGIN_ROOT/.husky/"post-merge "$@"
