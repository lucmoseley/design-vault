# check-text.py's word lists (#314): one `[list]` header, then one entry a
# line. A project adds its own entries with --words FILE in this form; its
# proper nouns and acronyms keep vault.label-case and vault.typed-case from
# reading its names as title case or typed capitals.

[acronyms]
API
ATM
CAPTCHA
CSS
EU
FAQ
GPS
HTML
ID
NASA
OK
PDF
TV
UK
UN
UNESCO
URL
US
USA
WC

# Currency codes (ISO 4217): typed in capitals, like an acronym.
[currencies]
AUD
CAD
CHF
CNY
EUR
GBP
HKD
IDR
INR
JPY
NZD
SGD
THB
USD

# Words capitalised wherever they stand: vault.label-case reads them as names.
[proper-nouns]
I
Monday
Tuesday
Wednesday
Thursday
Friday
Saturday
Sunday
January
February
March
April
May
June
July
August
September
October
November
December

# Common words of labels: vault.label-case reads one capitalised after the
# first word as title case, as it does a word the page writes in lower case.
[common-words]
a
about
all
an
and
as
at
back
book
by
for
from
get
go
here
how
in
into
is
it
learn
more
new
next
now
of
off
on
or
our
out
over
read
see
sign
start
started
the
to
today
up
us
view
we
with
you
your

# Elisions an apostrophe opens: vault.prose-quotes fails ‘ before one.
[elisions]
cause
em
n
til
tis
twas

# Units a number takes: vault.nonbreaking wants a no-break space between.
[units]
cm
g
GB
h
Hz
kB
kg
kHz
km
km/h
kW
l
lb
m
MB
mg
MHz
min
ml
mm
mph
ms
oz
pt
px
TB
°C
°F

# Reference labels a number or letter follows: vault.nonbreaking wants a
# no-break space after; vault.sentence-space reads their full stop as no
# sentence end.
[reference-labels]
§
¶
Chapter
chapter
Ex.
Fig.
fig.
No.
no.
p.
page
Page
pp.
Vol.
vol.

# Honorifics a name follows: vault.nonbreaking wants a no-break space after.
[honorifics]
Dr.
Mr.
Mrs.
Ms.
Prof.
Sgt.

# Signs that come before their word: vault.nonbreaking wants a no-break
# space after. ® and ™ sit against the word before them, so are none.
[signs]
©
℗

# Words beside a time: vault.locale-numbers reads 10.30 beside one as a time,
# not a decimal.
[time-words]
a.m.
am
h
p.m.
pm
Uhr

# Times written as words: vault.offer-end-date reads one as the deadline's time.
[clock-words]
midday
midnight
noon

# 12-hour markers: vault.week-hour reads a time with one as 12-hour.
[meridiem]
a.m.
am
AM
p.m.
pm
PM

# Time zone names: vault.offer-end-date reads one, or UTC or GMT with an
# offset, or an IANA Area/City name, as the deadline's zone.
[time-zones]
AEDT
AEST
AKDT
AKST
BST
CDT
CEST
CET
CST
CT
EDT
EEST
EET
EST
ET
GMT
HKT
HST
ICT
IST
JST
KST
MDT
MSK
MST
MT
NZDT
NZST
PDT
PHT
PST
PT
SAST
SGT
UTC
WEST
WET
WIB
WIT
WITA

# Words that count before a slash: vault.fractions reads 1/5 after one as a
# count, not a fraction.
[count-words]
episode
item
of
page
photo
picture
rated
score
season
slide
step
